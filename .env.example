# ============================================
# SkillForge Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (MongoDB Atlas free tier) ---
# Get your connection string from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillforge?retryWrites=true&w=majority

# --- Authentication ---
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# --- Supabase (alternative to MongoDB — optional) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_anon_key_here
# SUPABASE_SERVICE_KEY=your_service_key_here

# --- GitHub OAuth ---
# Register at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# --- Piston API (Code Execution) ---
# Free API, no key required
# Public instance: https://emkc.org/api/v2/piston
PISTON_API_URL=https://emkc.org/api/v2/piston

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:5000
